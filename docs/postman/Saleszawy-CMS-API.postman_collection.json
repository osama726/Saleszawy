{
    "info": {
        "name": "Saleszawy CMS API",
        "description": "Postman collection for the Saleszawy CMS public API.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "_exporter_id": "saleszawy-cms"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8000/api",
            "type": "string"
        },
        {
            "key": "slug",
            "value": "home",
            "type": "string"
        },
        {
            "key": "blockKey",
            "value": "faq",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Pages",
            "description": "Endpoints for published CMS pages.",
            "item": [
                {
                    "name": "Get published page by slug",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/v1/pages/{{slug}}",
                            "host": ["{{baseUrl}}"],
                            "path": ["v1", "pages", "{{slug}}"]
                        },
                        "description": "Returns a published page and its visible blocks. The page must have published status and a published_at date that is not in the future."
                    },
                    "response": [
                        {
                            "name": "Success",
                            "originalRequest": {
                                "method": "GET",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json",
                                        "type": "text"
                                    }
                                ],
                                "url": {
                                    "raw": "{{baseUrl}}/v1/pages/home",
                                    "host": ["{{baseUrl}}"],
                                    "path": ["v1", "pages", "home"]
                                }
                            },
                            "status": "OK",
                            "code": 200,
                            "header": [
                                {
                                    "key": "Content-Type",
                                    "value": "application/json"
                                }
                            ],
                            "body": "{\n  \"success\": true,\n  \"message\": \"\",\n  \"data\": {\n    \"id\": 1,\n    \"slug\": \"home\",\n    \"title\": \"سيلزواي\",\n    \"seo\": {\n      \"title\": \"سيلزواي - نظام إدارة علاقات العملاء\",\n      \"description\": \"الوصف الخاص بمحركات البحث\"\n    },\n    \"published_at\": \"2026-11-22T12:00:00+00:00\",\n    \"updated_at\": \"2026-11-22T12:30:00+00:00\",\n    \"blocks\": [\n      {\n        \"id\": 1,\n        \"key\": \"hero\",\n        \"type\": \"hero\",\n        \"data\": {\n          \"headline\": \"أكبر منصة مبيعات في الشرق الأوسط\"\n        }\n      }\n    ]\n  },\n  \"meta\": {}\n}"
                        },
                        {
                            "name": "Page not found",
                            "originalRequest": {
                                "method": "GET",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json",
                                        "type": "text"
                                    }
                                ],
                                "url": {
                                    "raw": "{{baseUrl}}/v1/pages/not-found",
                                    "host": ["{{baseUrl}}"],
                                    "path": ["v1", "pages", "not-found"]
                                }
                            },
                            "status": "Not Found",
                            "code": 404,
                            "header": [
                                {
                                    "key": "Content-Type",
                                    "value": "application/json"
                                }
                            ],
                            "body": "{\n  \"success\": false,\n  \"message\": \"العنصر المطلوب غير موجود\",\n  \"code\": \"NOT_FOUND\"\n}"
                        }
                    ],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status is 200 or 404', function () {",
                                    "  pm.expect([200, 404]).to.include(pm.response.code);",
                                    "});",
                                    "",
                                    "pm.test('Response has unified JSON envelope', function () {",
                                    "  pm.response.to.have.header('Content-Type');",
                                    "  const body = pm.response.json();",
                                    "  pm.expect(body).to.have.property('success');",
                                    "  pm.expect(body).to.have.property('message');",
                                    "});",
                                    "",
                                    "if (pm.response.code === 200) {",
                                    "  pm.test('Page data is valid', function () {",
                                    "    const body = pm.response.json();",
                                    "    pm.expect(body.success).to.eql(true);",
                                    "    pm.expect(body.data).to.have.property('slug');",
                                    "    pm.expect(body.data).to.have.property('blocks');",
                                    "  });",
                                    "}"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Get published page block by key",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/v1/pages/{{slug}}/blocks/{{blockKey}}",
                            "host": ["{{baseUrl}}"],
                            "path": [
                                "v1",
                                "pages",
                                "{{slug}}",
                                "blocks",
                                "{{blockKey}}"
                            ]
                        },
                        "description": "Returns one visible block from a published page using the block key. Hidden, unknown, or missing page/block keys return 404."
                    },
                    "response": [
                        {
                            "name": "Success",
                            "originalRequest": {
                                "method": "GET",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json",
                                        "type": "text"
                                    }
                                ],
                                "url": {
                                    "raw": "{{baseUrl}}/v1/pages/home/blocks/faq",
                                    "host": ["{{baseUrl}}"],
                                    "path": [
                                        "v1",
                                        "pages",
                                        "home",
                                        "blocks",
                                        "faq"
                                    ]
                                }
                            },
                            "status": "OK",
                            "code": 200,
                            "header": [
                                {
                                    "key": "Content-Type",
                                    "value": "application/json"
                                }
                            ],
                            "body": "{\n  \"success\": true,\n  \"message\": \"\",\n  \"data\": {\n    \"id\": 1,\n    \"key\": \"faq\",\n    \"type\": \"faq\",\n    \"data\": {\n      \"title\": \"FAQ\"\n    }\n  },\n  \"meta\": {}\n}"
                        },
                        {
                            "name": "Block not found",
                            "originalRequest": {
                                "method": "GET",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json",
                                        "type": "text"
                                    }
                                ],
                                "url": {
                                    "raw": "{{baseUrl}}/v1/pages/home/blocks/nope",
                                    "host": ["{{baseUrl}}"],
                                    "path": [
                                        "v1",
                                        "pages",
                                        "home",
                                        "blocks",
                                        "nope"
                                    ]
                                }
                            },
                            "status": "Not Found",
                            "code": 404,
                            "header": [
                                {
                                    "key": "Content-Type",
                                    "value": "application/json"
                                }
                            ],
                            "body": "{\n  \"success\": false,\n  \"message\": \"العنصر المطلوب غير موجود\",\n  \"code\": \"NOT_FOUND\"\n}"
                        }
                    ],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status is 200 or 404', function () {",
                                    "  pm.expect([200, 404]).to.include(pm.response.code);",
                                    "});",
                                    "",
                                    "if (pm.response.code === 200) {",
                                    "  pm.test('Block data is valid', function () {",
                                    "    const body = pm.response.json();",
                                    "    pm.expect(body.success).to.eql(true);",
                                    "    pm.expect(body.data).to.have.property('key');",
                                    "    pm.expect(body.data).to.have.property('type');",
                                    "    pm.expect(body.data).to.have.property('data');",
                                    "  });",
                                    "}"
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "Layout",
            "description": "Header and footer payload endpoints.",
            "item": [
                {
                    "name": "Get complete layout",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/v1/layout",
                            "host": ["{{baseUrl}}"],
                            "path": ["v1", "layout"]
                        },
                        "description": "Returns header and footer together."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                                    "const body = pm.response.json();",
                                    "pm.test('Layout contains header and footer', function () {",
                                    "  pm.expect(body.success).to.eql(true);",
                                    "  pm.expect(body.data).to.have.property('header');",
                                    "  pm.expect(body.data).to.have.property('footer');",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Get header",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/v1/layout/header",
                            "host": ["{{baseUrl}}"],
                            "path": ["v1", "layout", "header"]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                                    "const body = pm.response.json();",
                                    "pm.test('Header shape is valid', function () {",
                                    "  pm.expect(body.success).to.eql(true);",
                                    "  pm.expect(body.data).to.have.property('brand');",
                                    "  pm.expect(body.data).to.have.property('links');",
                                    "  pm.expect(body.data).to.have.property('actions');",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Get footer",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/v1/layout/footer",
                            "host": ["{{baseUrl}}"],
                            "path": ["v1", "layout", "footer"]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                                    "const body = pm.response.json();",
                                    "pm.test('Footer shape is valid', function () {",
                                    "  pm.expect(body.success).to.eql(true);",
                                    "  pm.expect(body.data).to.have.property('brand');",
                                    "  pm.expect(body.data).to.have.property('columns');",
                                    "  pm.expect(body.data).to.have.property('copyright');",
                                    "});"
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "Plans",
            "description": "Published subscription plans.",
            "item": [
                {
                    "name": "List published plans",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/v1/plans",
                            "host": ["{{baseUrl}}"],
                            "path": ["v1", "plans"]
                        },
                        "description": "Returns published plans ordered by sort_order."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                                    "const body = pm.response.json();",
                                    "pm.test('Plans data is valid', function () {",
                                    "  pm.expect(body.success).to.eql(true);",
                                    "  pm.expect(body.data).to.be.an('array');",
                                    "  if (body.data.length) {",
                                    "    pm.expect(body.data[0]).to.have.property('price');",
                                    "    pm.expect(body.data[0]).to.have.property('limits');",
                                    "    pm.expect(body.data[0]).to.have.property('features');",
                                    "  }",
                                    "});"
                                ]
                            }
                        }
                    ]
                }
            ]
        }
    ]
}
